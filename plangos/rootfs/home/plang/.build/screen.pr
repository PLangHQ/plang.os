{
  "name": "Screen",
  "step": [
    {
      "index": 0,
      "text": "browser.start(Url=\"file:///home/plang/desktop.html\", Width=1920, Height=1080, ToOutput=true, OnWindow=goal.call(Name=\"Window\"), OnMessage=goal.call(Name=\"Desktop\")); variable.set(Name=%browser%, Value=%!data%)",
      "line": {
        "number": 7
      },
      "comment": "PlangOS's side of the screen. Host plang starts this (wsl … /opt/plang/plang Screen). The\nbrowser draws into plang-screen, whose binary frames go straight to this app's output — the\npipe to host plang — untouched. Input from the host's screen comes down on stdin, one line\nper event. Ends when the host closes the pipe.\nThe first page is the desktop; every app opens in a window of its own.",
      "code": [
        {
          "module": "browser",
          "name": "start",
          "property": [
            {
              "name": "Url",
              "type": {
                "name": "text"
              },
              "value": "file:///home/plang/desktop.html"
            },
            {
              "name": "ToOutput",
              "type": {
                "name": "bool"
              },
              "value": true
            },
            {
              "name": "OnWindow",
              "type": {
                "name": "action"
              },
              "value": {
                "module": "goal",
                "name": "call",
                "property": [
                  {
                    "name": "Name",
                    "type": {
                      "name": "text"
                    },
                    "value": "Window"
                  }
                ],
                "default": [
                  {
                    "name": "parallel",
                    "type": {
                      "name": "bool"
                    },
                    "value": false
                  }
                ]
              }
            },
            {
              "name": "OnMessage",
              "type": {
                "name": "action"
              },
              "value": {
                "module": "goal",
                "name": "call",
                "property": [
                  {
                    "name": "Name",
                    "type": {
                      "name": "text"
                    },
                    "value": "Desktop"
                  }
                ],
                "default": [
                  {
                    "name": "parallel",
                    "type": {
                      "name": "bool"
                    },
                    "value": false
                  }
                ]
              }
            }
          ],
          "default": [
            {
              "name": "width",
              "type": {
                "name": "number"
              },
              "value": 1920
            },
            {
              "name": "height",
              "type": {
                "name": "number"
              },
              "value": 1080
            },
            {
              "name": "format",
              "type": {
                "name": "text"
              },
              "value": "jpeg"
            },
            {
              "name": "quality",
              "type": {
                "name": "number"
              },
              "value": 80
            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%browser%",
              "variable": [

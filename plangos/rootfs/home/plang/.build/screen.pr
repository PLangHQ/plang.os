{
  "name": "Screen",
  "step": [
    {
      "index": 0,
      "text": "screen.open(ToOutput=true, OnWindow=goal.call(Name=\"Window\")); variable.set(Name=%screen%, Value=%!data%)",
      "line": {
        "number": 7
      },
      "comment": "PlangOS's side of the screen. Host plang starts this (wsl … /opt/plang/plang Screen). The\nscreen is PlangOS's display: programs draw onto it, and its frames go to this app's output —\nthe pipe to host plang. Input from the host comes down on stdin, one line per event, and goes\nto the screen. Ends when the host closes the pipe.\nThe first page is the desktop; every app opens in a window of its own.",
      "code": [
        {
          "module": "screen",
          "name": "open",
          "property": [
            {
              "name": "ToOutput",
              "type": {
                "name": "bool"
              },
              "value": true
            },
            {
              "name": "OnWindow",
              "type": {
                "name": "action"
              },
              "value": {
                "module": "goal",
                "name": "call",
                "property": [
                  {
                    "name": "Name",
                    "type": {
                      "name": "text"
                    },
                    "value": "Window"
                  }
                ],
                "default": [
                  {
                    "name": "parallel",
                    "type": {
                      "name": "bool"
                    },
                    "value": false
                  }
                ]
              }
            }
          ],
          "default": [

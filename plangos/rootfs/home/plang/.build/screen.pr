{
  "name": "Screen",
  "step": [
    {
      "index": 0,
      "text": "start browser 'https://www.visir.is', size 1920x1080, frames to output, write to %browser%",
      "line": {
        "number": 6
      },
      "comment": "PlangOS's side of the screen. Host plang starts this (wsl … /opt/plang/plang Screen). The\nbrowser draws into plang-screen, whose binary frames go straight to this app's output — the\npipe to host plang — untouched. Input from the host's screen comes down on stdin, one line\nper event. Ends when the host closes the pipe.",
      "code": [
        {

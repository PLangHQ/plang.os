              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%!data%",
              "variable": [
                {
                  "text": "%!data%",
                  "code": [
                    {
                      "variable": "!data"
                    }
                  ]
                }
              ]
            }
          ],
          "default": [

                      "text": "%asked.about.app%",
                      "code": [
                        {
                          "variable": "asked"
                        },
                        {
                          "property": "about"
                        },
                        {
                          "property": "app"
                        }
                      ]
                    }
                  ]
                }
              ],
              "default": [
                {
                  "name": "default",
                  "type": {
                    "name": "bool"
                  },
                  "value": false
                }
              ]
            }
          ]
        },
        {
          "index": 1,
          "text": "condition.if(Left=%claudeStarted%, Operator=\"isnotempty\") { goal.call(Name=\"NextWords\") }",
          "line": {
            "number": 194
          },
          "code": [
            {
              "module": "condition",
              "name": "if",
              "property": [
                {
                  "name": "Left",
                  "type": {
                    "name": "item",
                    "template": "plang"
                  },
                  "value": "%claudeStarted%",
                  "variable": [
                    {
                      "text": "%claudeStarted%",
                      "code": [
                        {
                          "variable": "claudeStarted"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Operator",
                  "type": {
                    "name": "choice",
                    "kind": "operator"
                  },
                  "value": "isnotempty"
                }
              ],
              "child": [
                {
                  "index": 0,
                  "text": "goal.call(Name=\"NextWords\")",

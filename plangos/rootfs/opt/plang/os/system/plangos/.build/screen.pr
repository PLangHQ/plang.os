    {
      "name": "ShowError",
      "step": [
        {
          "index": 0,
          "text": "window.call(Name=\"ErrorShow\", Window=%browser.desktop%, Parameter={error: %message%, where: %where%})",
          "line": {
            "number": 57
          },
          "comment": "An error written to an error channel is %message%, and where it happened %where% ({goal, step}; there only when\nit happened in a goal): the desktop lists it (what, where, when) and counts it on the taskbar.",
          "code": [
            {
              "module": "window",
              "name": "call",
              "property": [
                {
                  "name": "Name",
                  "type": {
                    "name": "text"
                  },
                  "value": "ErrorShow"
                },
                {
                  "name": "Window",
                  "type": {
                    "name": "item",
                    "template": "plang"
                  },
                  "value": "%browser.desktop%",
                  "variable": [
                    {
                      "text": "%browser.desktop%",
                      "code": [
                        {
                          "variable": "browser"
                        },
                        {
                          "property": "desktop"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Parameter",
                  "type": {
                    "name": "list"
                  },
                  "value": [{"name":"error","type":{"name":"item","template":"plang"},"value":"%message%","variable":[{"text":"%message%","code":[{"variable":"message"}]}]},{"name":"where","type":{"name":"item","template":"plang"},"value":"%where%","variable":[{"text":"%where%","code":[{"variable":"where"}]}]}]
                }
              ]
            }
          ]
        },
        {
          "index": 1,
          "text": "output.write(Data={\"error\": %message%, \"where\": %where%}, channel=\"errorlog\")",
          "line": {
            "number": 60
          },
          "comment": "and to the host, which keeps it (errors.jsonl in its folder): read there, no copying from the screen — through the\nerrorlog channel, the door to the host the screen opened",
          "code": [
            {
              "module": "output",
              "name": "write",
              "property": [
                {
                  "name": "Data",
                  "type": {
                    "name": "dict",
                    "template": "plang"

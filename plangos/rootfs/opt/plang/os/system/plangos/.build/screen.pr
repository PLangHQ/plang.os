{
  "name": "Screen",
  "step": [
    {
      "index": 0,
      "text": "screen.open(ToOutput=true); variable.set(Name=%screen%, Value=%!data%)",
      "line": {
        "number": 10
      },
      "comment": "PlangOS's shell: part of the system (plang's os folder, read-only, comes with the image), run in\nthe person's app, /home/plang — their files, their .db. Host plang starts it (wsl … --cd\n/home/plang … /opt/plang/plang system/plangos/Screen).\nPlangOS's side of the screen. The\nscreen is PlangOS's display: programs draw onto it, and its frames go to this app's output —\nthe pipe to host plang. Input from the host comes down on stdin, one line per event, and goes\nto the screen. Ends when the host closes the pipe.\nThe first page is the desktop; every app opens in a window of its own.",
      "code": [
        {
          "module": "screen",
          "name": "open",
          "property": [
            {
              "name": "ToOutput",
              "type": {
                "name": "bool"
              },
              "value": true
            }
          ],
          "default": [
            {
              "name": "title",
              "type": {
                "name": "text"
              },
              "value": "PlangOS"
            },
            {
              "name": "width",
              "type": {
                "name": "number"
              },
              "value": 1920
            },
            {
              "name": "height",
              "type": {
                "name": "number"
              },
              "value": 1080
            }
          ]
        },
        {
          "module": "variable",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "variable"
              },
              "value": "%screen%",
              "variable": [
                {
                  "text": "%screen%",
                  "code": [
                    {
                      "variable": "screen"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%!data%",
              "variable": [
                {
                  "text": "%!data%",
                  "code": [
                    {
                      "variable": "!data"
                    }
                  ]
                }
              ]
            }
          ],
          "default": [
            {
              "name": "default",
              "type": {
                "name": "bool"
              },
              "value": false
            }
          ]
        }
      ]
    },
    {

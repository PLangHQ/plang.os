      "step": [
        {
          "index": 0,
          "text": "set %click% to %!event!result%",
          "line": {
            "number": 184
          },
          "comment": "☰ clicked (#window.bot): Claude's box drops down under it — part of the desktop page, lifted above the\nwindows. %!event!result% is the click: its window, where.",
          "code": [
            {
              "module": "variable",

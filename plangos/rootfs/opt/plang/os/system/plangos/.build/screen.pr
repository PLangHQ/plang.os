      "index": 14,
      "text": "channel.set(Name=\"error\", Goal=goal.call(Name=\"ShowError\"))",
      "line": {
        "number": 30
      },
      "comment": "Every error — in the shell's goals, a click's or a window's callback, the system's own — shows on the desktop's\ntaskbar: nothing fails where no one sees it.",
      "code": [
        {
          "module": "channel",
          "name": "set",
          "property": [
            {
              "name": "Name",
              "type": {
                "name": "text"
              },
              "value": "error"
            },
            {
              "name": "Goal",
              "type": {
                "name": "action"
              },
              "value": {
                "module": "goal",
                "name": "call",
                "property": [
                  {
                    "name": "Name",
                    "type": {
                      "name": "goal"
                    },
                    "value": "ShowError"
                  }
                ],
                "default": [
                  {
                    "name": "parallel",
                    "type": {
                      "name": "bool"
                    },
                    "value": false
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "index": 15,
      "text": "goal.call(Name=\"Files\")",
      "line": {
        "number": 32
      },
      "comment": "the desktop's files, once %browser% is known (the page itself can't ask: it loads while browser.start runs)",
      "code": [
        {
          "module": "goal",
          "name": "call",
          "property": [
            {
              "name": "Name",
              "type": {

    {
      "name": "Say",
      "step": [
        {
          "index": 0,
          "text": "set %claudeApp% to %asked.about.app%",
          "line": {
            "number": 193
          },
          "comment": "The person wrote to Claude about a window. The first time, with what Claude has to know about PlangOS\nand this window (agent/instructions.md); then it's a conversation. Claude's paths are in the window's app\n(%asked.about.app%: its folder, as the box worked it out from its page; none for a website).",
          "code": [
            {
              "module": "variable",
              "name": "set",
              "property": [
                {
                  "name": "Name",
                  "type": {
                    "name": "variable"
                  },
                  "value": "%claudeApp%",
                  "variable": [
                    {
                      "text": "%claudeApp%",
                      "code": [
                        {
                          "variable": "claudeApp"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "Value",
                  "type": {

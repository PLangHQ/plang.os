      ]
    },
    {
      "index": 18,
      "text": "on.event(Event=%!screen.element[\"#window.bot\"].on.click%, When=\"after\", Action=goal.call(Name=\"ShowClaude\"))",
      "line": {
        "number": 39
      },
      "comment": "☰ on a window is its agent: Claude, who works on the window's app with the person, through plang.\n(on click on #window.bot, call ShowClaude — formal until the builder learns # elements)",

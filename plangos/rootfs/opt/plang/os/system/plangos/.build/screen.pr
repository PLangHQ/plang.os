            }
          ]
        },
        {
          "index": 2,
          "text": "condition.if(Left=%claudeStarted%, Operator=\"isempty\") { goal.call(Name=\"FirstWords\") }",
          "line": {
            "number": 195
          },
          "code": [
            {
              "module": "condition",
              "name": "if",
              "property": [
                {
                  "name": "Left",
                  "type": {
                    "name": "item",
                    "template": "plang"
                  },

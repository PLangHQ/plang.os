    {
      "name": "Turn",
      "step": [
        {
          "index": 0,
          "text": "goal.call(Name=%!app.parent.goal[\"Claude\"]%, Parameter={message: %content%, session: %!app.id%, first: %claudeFirst%}); on.error(Recovery=[goal.call(Name=\"ClaudeFailed\")]); variable.set(Name=%reply%, Value=%!data%)",
          "line": {
            "number": 226
          },
          "comment": "One turn: Claude, in the host (the app that started this one), gets %content%; its words go to the box;\nthe goals it asks for run here, and what they gave is its next turn — until it asks for none. The host keeps\nthe conversation under this app's id (%!app.id%: several apps may talk to Claude through one host); the first\nturn of a conversation starts it afresh.",
          "code": [
            {
              "module": "goal",
              "name": "call",
              "property": [
                {
                  "name": "Name",
                  "type": {
                    "name": "goal",
                    "template": "plang"

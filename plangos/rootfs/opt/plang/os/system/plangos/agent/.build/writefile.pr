{
  "name": "WriteFile",
  "step": [
    {
      "index": 0,
      "text": "condition.if(Left=%path%, Operator=\"startswith\", Right=\"/system/plangos/app/\") { goal.call(Name=\"NotHere\") }",
      "line": {
        "number": 5
      },
      "comment": "Writes %content% to the file at %path%, all of it (a new file, or in place of what it held).\nAn app that came with PlangOS is changed from its own window (its ☰): there the change makes it the person's, kept\nwhen PlangOS gets a new image. Written here, in PlangOS's copy, the next image would take it away.",
      "code": [
        {
          "module": "condition",
          "name": "if",
          "property": [
            {
              "name": "Left",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%path%",
              "variable": [
                {
                  "text": "%path%",
                  "code": [
                    {
                      "variable": "path"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Operator",
              "type": {
                "name": "choice",
                "kind": "operator"
              },
              "value": "startswith"
            },
            {
              "name": "Right",
              "type": {
                "name": "text"
              },
              "value": "/system/plangos/app/"
            }
          ],
          "child": [
            {
              "index": 0,
              "text": "goal.call(Name=\"NotHere\")",
              "line": {
                "number": 5
              },
              "code": [
                {
                  "module": "goal",
                  "name": "call",
                  "property": [
                    {
                      "name": "Name",
                      "type": {
                        "name": "goal"
                      },
                      "value": "NotHere"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "index": 1,
      "text": "file.save(Path=%path%, Value=%content%)",
      "line": {
        "number": 6
      },
      "code": [
        {
          "module": "file",
          "name": "save",
          "property": [
            {
              "name": "Path",
              "type": {
                "name": "path",
                "template": "plang"
              },
              "value": "%path%",
              "variable": [
                {
                  "text": "%path%",
                  "code": [
                    {
                      "variable": "path"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Value",
              "type": {
                "name": "item",
                "template": "plang"
              },
              "value": "%content%",
              "variable": [
                {
                  "text": "%content%",
                  "code": [
                    {
                      "variable": "content"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "index": 2,
      "text": "return \"written\"",
      "line": {
        "number": 7
      },
      "code": [
        {
          "module": "goal",
          "name": "return",
          "property": [
            {
              "name": "Data",
              "type": {
                "name": "text"
              },
              "value": "written"
            }
          ],
          "default": [
            {
              "name": "depth",
              "type": {
                "name": "number"
              },
              "value": 1
            }
          ]
        }
      ]
    }
  ],
  "child": [
    {
      "name": "NotHere",
      "step": [
        {
          "index": 0,
          "text": "throw error \"%path% is an app that comes with PlangOS; a change written here is lost with the next PlangOS. Ask the person to open the app and change it from its window's ☰: it then becomes theirs, and is kept.\"",
          "line": {
            "number": 10
          },
          "code": [
            {
              "module": "error",
              "name": "throw",
              "property": [
                {
                  "name": "Message",
                  "type": {
                    "name": "text",
                    "template": "plang"
                  },
                  "value": "\"%path% is an app that comes with PlangOS; a change written here is lost with the next PlangOS. Ask the person to open the app and change it from its window's ☰: it then becomes theirs, and is kept.\"",
                  "variable": [
                    {
                      "text": "%path%",
                      "code": [
                        {
                          "variable": "path"
                        }
                      ]
                    }
                  ]
                }
              ],
              "default": [
                {
                  "name": "status",
                  "type": {
                    "name": "status"
                  },
                  "value": 400
                },
                {
                  "name": "key",
                  "type": {
                    "name": "text"
                  },
                  "value": "error"
                }
              ]
            }
          ]
        }
      ],

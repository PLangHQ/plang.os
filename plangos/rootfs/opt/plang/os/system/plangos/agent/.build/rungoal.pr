{
  "name": "RunGoal",
  "step": [
    {
      "index": 0,
      "text": "terminal.start(App=\"plang\", Parameter=[%goal%]); on.timeout(After=\"PT5M\"); variable.set(Name=%ran%, Value=%!data%)",
      "line": {
        "number": 4
      },
      "comment": "Runs the goal %goal% of the person's app (its name from the app's root: Desktop/Start), in a plang\nof its own: what it wrote, and its exit code.",
      "code": [
        {
          "module": "terminal",
          "name": "start",
          "property": [
            {
              "name": "App",
              "type": {
                "name": "text"
              },

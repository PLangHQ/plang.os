Claude
/ One turn with Claude, for the app this one started — PlangOS calls it (call goal Claude in %!app.parent%).
/ %message% is what the person said, as Claude reads it: a list of parts (text, and pictures — a screenshot).
/ Claude runs here, on Windows: the person's own Claude Code, with no tools of its own (none built in, no MCP),
/ so it can't act on this computer — it acts only through what it answers, {text, calls}: its words, and the
/ plang goals it asks PlangOS to run. Its session carries the conversation from turn to turn.
- set %claudeSaid% to ""
/ the shape every answer has (a JSON schema)
- read 'answer.shape.txt', write to %answerShape%
- set %claudeInput% to {"type": "user", "message": {"role": "user", "content": %message%}}
- condition.if(Left=%claudeSession%, Operator="isnotempty") { goal.call(Name="NextTurn") }
- condition.if(Left=%claudeSession%, Operator="isempty") { goal.call(Name="FirstTurn") }
- variable.set(Name=%claudeAnswer%, Value=%claudeSaid%, Type="dict")
- set %claudeSession% to %claudeAnswer.session_id%
- return %claudeAnswer.structured_output%

FirstTurn
- terminal.start(App="claude", Parameter=["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose", "--tools", "", "--strict-mcp-config", "--mcp-config", "{\"mcpServers\":{}}", "--json-schema", %answerShape%], Input=%claudeInput%, OnOutput=goal.call(Name="ClaudeLine")); on.timeout(After="PT10M")

NextTurn
- terminal.start(App="claude", Parameter=["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose", "--tools", "", "--strict-mcp-config", "--mcp-config", "{\"mcpServers\":{}}", "--json-schema", %answerShape%, "--resume", %claudeSession%], Input=%claudeInput%, OnOutput=goal.call(Name="ClaudeLine")); on.timeout(After="PT10M")

ClaudeLine
/ Each line Claude writes is one event; the turn's answer is the result — the one with its structured_output.
- set %claudeLine% to %!data%
- condition.if(Left=%claudeLine%, Operator="contains", Right="structured_output") { goal.call(Name="KeepResult") }

KeepResult
- set %claudeSaid% to %claudeLine%

# Large build artifacts that live outside the repo.
# See container/build.sh for how the zip is sourced (defaults to
# /shared/plang-amd64.zip, overridable with PLANG_ZIP env var).
container/plang-*.zip

# Transient PLang build output under subdirectories (e.g. for goals checked
# out elsewhere in the tree). The repo-root .build/ is intentionally tracked:
# it holds the pre-built .pr for Start.goal so the image build does not need
# an LLM call. Regenerate via `plang build` and commit when Start.goal changes.
**/.build/
!/.build/
!/.build/**

# Bot output lives on feature branches, not main — but tracked in PRs per
# CLAUDE.md. Don't ignore .bot/.
